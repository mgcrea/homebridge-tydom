{
  "name": "homebridge-tydom",
  "displayName": "Tydom",
  "version": "0.31.1",
  "description": "Homebridge plugin to manage Tydom devices by Delta Dore",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/homebridge-tydom.git"
  },
  "homepage": "https://github.com/mgcrea/homebridge-tydom#readme",
  "bugs": "https://github.com/mgcrea/homebridge-tydom/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "tydom",
    "delta-dore",
    "tyxal",
    "tyxia",
    "domotics",
    "home-automation"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "format": "oxfmt --write src/ test/ scripts/",
    "format:check": "oxfmt --check src/ test/ scripts/",
    "check": "tsc --noEmit",
    "spec": "vitest --run",
    "coverage": "vitest --run --coverage",
    "watch": "vitest",
    "hash": "tsx scripts/hash.ts",
    "resolve-credentials": "tsx scripts/resolve-credentials.ts",
    "validate:dumps": "tsx scripts/validate-dumps.ts",
    "dev:homebridge": "homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "dev:homebridge:insecure": "NODE_TLS_REJECT_UNAUTHORIZED=0 homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "clean": "rm -rf .homebridge/persist/* .homebridge/accessories/*",
    "test": "pnpm run lint && pnpm run check && pnpm run spec && pnpm run format:check",
    "release": "release-it",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "kolorist": "^1.8.0",
    "source-map-support": "^0.5.21",
    "tydom-client": "^0.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/debug": "^4.1.13",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "homebridge": "^2.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.29.3"
}
