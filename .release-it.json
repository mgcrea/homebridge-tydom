{
  "hooks": {
    "before:init": ["pnpm run test", "pnpm run build"]
  },
  "npm": {
    "publish": false
  },
  "git": {
    "commitMessage": "chore(release): cut the v${version} release",
    "tagAnnotation": "v${version} release",
    "requireBranch": "main",
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  }
}
